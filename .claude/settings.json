{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test *)",
      "Bash(npm run typecheck)",
      "Bash(npm run check)",
      "Bash(npx vitest *)",
      "Bash(npx tsc --noEmit)"
    ],
    "ask": [
      "Bash(npx wrangler deploy)",
      "Bash(npx wrangler deploy *)",
      "Bash(npm run deploy)",
      "Bash(npm run deploy *)",
      "Bash(npx wrangler secret *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(npx wrangler d1 * --remote*)",
      "Bash(npx.cmd wrangler d1 * --remote*)",
      "Bash(npx wrangler d1 time-travel restore *)",
      "Bash(npx.cmd wrangler d1 time-travel restore *)",
      "Bash(npx.cmd wrangler deploy)",
      "Bash(npx.cmd wrangler deploy *)",
      "Bash(npx.cmd wrangler secret *)",
      "Bash(npm.cmd run deploy)",
      "Bash(npm.cmd run deploy *)",
      "PowerShell(git push *)",
      "PowerShell(npx.cmd wrangler deploy *)",
      "PowerShell(npx.cmd wrangler secret *)",
      "PowerShell(npx.cmd wrangler d1 * --remote*)",
      "PowerShell(npm.cmd run deploy *)",
      "mcp__plugin_cloudflare_cloudflare__execute",
      "Bash(npm run deploy:*)",
      "Bash(npm.cmd run deploy:*)",
      "PowerShell(npm run deploy:*)",
      "PowerShell(npm.cmd run deploy:*)"
    ],
    "deny": [
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./datos/**)"
    ]
  }
}
