{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test *)",
      "Bash(npm run typecheck)",
      "Bash(npm run check)",
      "Bash(npx vitest *)",
      "Bash(npx tsc --noEmit)"
    ],
    "ask": [
      "Bash(npx wrangler deploy *)",
      "Bash(npm run deploy)",
      "Bash(npx wrangler secret *)"
    ],
    "deny": [
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./datos/**)"
    ]
  }
}
