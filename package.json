{
  "name": "brunen-chatbot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Chatbot de WhatsApp para Brunen SpA (Cloudflare Workers + TypeScript)",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dev:panel": "wrangler dev -c wrangler.panel.toml",
    "deploy:panel": "wrangler deploy -c wrangler.panel.toml",
    "deploy:panel-admin": "wrangler deploy -c wrangler.panel.toml --env admin",
    "datos-locales": "wrangler d1 migrations apply brunen-chatbot --local && wrangler d1 execute brunen-chatbot --local --file scripts/datos-de-prueba.sql",
    "verificar-config": "node scripts/verificar-config.mjs",
    "simular-mensaje": "node scripts/simular-mensaje.mjs",
    "preparar-planilla": "node scripts/preparar-planilla.mjs",
    "anonimizar": "node scripts/anonimizar-excel.mjs",
    "cargar-historial": "node --max-old-space-size=3000 scripts/cargar-historial.mjs",
    "restaurar-respaldo": "node scripts/restaurar-respaldo.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
